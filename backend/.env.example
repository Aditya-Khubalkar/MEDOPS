# ─── Backend Environment Variables ───────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Google AI / Gemini ────────────────────────────────────────────────────────
# Required for Report Decoder (Gemini Vision).
GEMINI_API_KEY=

# Required for the ClinTrace triage agent (Google ADK / Gemini).
# Same key can be used for both if using Gemini API.
GOOGLE_API_KEY=

# ── ClinTrace Agent ───────────────────────────────────────────────────────────
# Model to use for triage inference. Defaults to gemini-2.5-flash if not set.
# CLINICTRACE_MODEL=gemini-2.5-flash

# ── Vertex AI Agent Engine (optional, for production deployment) ─────────────
# Leave blank to run the triage agent locally (in-process).
# Set to a deployed Vertex AI Agent Engine resource ID to call it remotely.
# AGENT_ENGINE_RESOURCE_ID=
# AGENT_ENGINE_REGION=us-central1
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# ── Phoenix Observability (optional) ─────────────────────────────────────────
# Arize Phoenix is used for tracing triage runs.
# Leave blank to disable observability (the app still works without it).
# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
# PHOENIX_PROJECT_NAME=medops
# PHOENIX_MCP_URL=

# ── Performance Tuning ────────────────────────────────────────────────────────
# FAST_TRIAGE=true              # Skip LLM feedback step (faster, saves ~10s)
# MERGE_TRIAGE_LLM_STEPS=true  # Merge ESI + red-flag into one call (saves ~2 calls)
