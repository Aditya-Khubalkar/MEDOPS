# ─── Frontend Environment Variables ──────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.

# URL of the MEDOPS FastAPI backend (no trailing slash)
VITE_BACKEND_URL=http://localhost:8000

# WebSocket URL of the backend (ws:// or wss://)
VITE_BACKEND_WS=ws://localhost:8000

# ─── Demo Mode ─────────────────────────────────────────────────────────────
# Set to "true" to enable a synthetic demo ambulance on the map.
# When false (default), all map data comes exclusively from real WebSocket events.
VITE_DEMO_MODE=false
